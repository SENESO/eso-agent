<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EsoAgent.App.App"
             RequestedThemeVariant="Default">
    <!-- Phase 2: the shell consumes the shared EsoTokens (Phase 0). The
         variant follows the OS (audit §3.1 decision 3): the refined-dark
         brand variant on dark systems, the same tokens' light variant on
         light systems — one token switch, no per-screen forks. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://EsoAgent.App/Themes/EsoTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
