<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EsoAgent.App.Views.ActivityView">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
            <Button x:Name="ExportButton" Content="Export JSON" Click="OnExportClick" />
            <TextBlock x:Name="StateText" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>
        <TextBox x:Name="BodyText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Consolas, Menlo, monospace" FontSize="12" />
    </DockPanel>
</UserControl>
