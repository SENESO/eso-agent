<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EsoAgent.App.Views.StatusView">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="Refresh status" Click="OnRefreshClick" />
            <Button x:Name="DiagnoseButton" Content="Diagnose — what's the problem?" Click="OnDiagnoseClick" />
            <Button x:Name="ApplyUpdateButton" Content="Apply update" Click="OnApplyUpdateClick" IsVisible="False" />
            <TextBlock x:Name="StateText" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>
        <ScrollViewer>
            <TextBlock x:Name="BodyText" FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap"
                       Text="Select a device, then refresh." />
        </ScrollViewer>
    </DockPanel>
</UserControl>
