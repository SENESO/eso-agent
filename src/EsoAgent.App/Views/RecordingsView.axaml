<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EsoAgent.App.Views"
             x:Class="EsoAgent.App.Views.RecordingsView">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
            <TextBlock x:Name="StateText" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Opacity="0.75" IsVisible="False"
                   Text="No recordings on this device." Margin="0,0,0,8" />
        <ListBox x:Name="RecordingsList" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:RecordingItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="2">
                        <StackPanel Spacing="2" Margin="4">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DetailLine}" FontSize="12" Opacity="0.75" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,2,0">
                            <Button Content="{Binding PlayLabel}" Click="OnRowPlayClick" Padding="10,3" />
                            <Button Content="{Binding DownloadLabel}" Click="OnRowDownloadClick" Padding="10,3" />
                            <Button Content="{Binding DeleteLabel}" Click="OnRowDeleteClick" Padding="10,3" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
