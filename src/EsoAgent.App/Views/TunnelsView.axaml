<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:EsoAgent.App.Views"
             x:Class="EsoAgent.App.Views.TunnelsView">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button x:Name="NewButton" Content="New tunnel…" Click="OnNewClick" />
            <TextBlock x:Name="StateText" VerticalAlignment="Center" Opacity="0.75" />
        </StackPanel>
        <TextBlock x:Name="HintText" DockPanel.Dock="Top" Opacity="0.75" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Tunnels bind a port on THIS computer and forward it through the selected device — RDP, SSH, or any TCP/UDP service the device can reach. They run while the app is open." />
        <ListBox x:Name="TunnelsList" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:TunnelItem">
                    <Grid ColumnDefinitions="*,Auto" Margin="2">
                        <StackPanel Spacing="2" Margin="4">
                            <TextBlock Text="{Binding Describe}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StateLine}" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,2,0">
                            <Button Content="{Binding ToggleLabel}" Click="OnRowToggleClick" Padding="10,3" />
                            <Button Content="{Binding RemoveLabel}" Click="OnRowRemoveClick" Padding="10,3" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
